          density = float(input("What's the density of the solute in g/mL? "))
          try:
            molecular_weight = float(input("What's the molecuar weight of the solute in g? "))
            try:
              purity = float(input("What's the purity of the solute of 100? "))
              solute_volume = format((concentration_value * volume * molecular_weight * 100) /(density * purity) , ".2e")
              print(f"The solute volume: {solute_volume} mL")

            except ValueError:
              print("Please enter a valid purity!")
          except ValueError:
