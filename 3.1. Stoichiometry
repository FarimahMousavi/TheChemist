if concentration_type.lower() == "a" or concentration_type.lower() == "(a)" or concentration_type.lower() == "molarity" or concentration_type.lower() == "(a) molarity" or concentration_type.lower() == "a molarity":
  try:
    volume = float(input("What's the volume of your desired solution in L? "))
    try:
      concentration_value = float(input("What's the absolute concentration value of your desired solution in molarity? "))
      if solute_type.lower() == "a" or solute_type.lower() == "(a)" or solute_type.lower() == "solid" or solute_type.lower() == "(a) solid" or solute_type.lower() == "a solid":
        try:
          molecular_weight = float(input("What's the molecuar weight of the solute in g? "))
          try:
            purity = float(input("What's the purity of the solute of 100? "))
            solute_mass = format(concentration_value * volume * molecular_weight * 100 / purity, ".2e")
            print(f"The solute mass: {solute_mass} g")

          except ValueError:
            print("Please enter a valid purity!")
        except ValueError:
          print("Please enter a valid molecular weight!")

      elif solute_type.lower() == "b" or solute_type.lower() == "(b)" or solute_type.lower() == "liquid" or solute_type.lower() == "(b) liquid" or solute_type.lower() == "b liquid":
