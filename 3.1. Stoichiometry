        except ValueError:
          print("Please enter a valid density!")

      elif solute_type.lower() == "c" or solute_type.lower() == "(c)" or solute_type.lower() == "solution" or solute_type.lower() == "(c) solution" or solute_type.lower() == "c solution":
        try:
          solute_concentration = float(input("What's the concentration of the concentrated solution in molarity? "))
          solute_volume = format(concentration_value * volume * 1000 / solute_concentration, ".2e")
          print(f"The concentrated solution volume: {solute_volume} mL")

        except ValueError:
          print("Please enter a valid concentration value!")

      else:
        print("Please enter a correct solute type!")


    except ValueError:
      print("Please enter a valid concentration value!")

  except ValueError:
    print("Please enter a valid volume value!")


